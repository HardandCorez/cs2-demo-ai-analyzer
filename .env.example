# === Local AI via Ollama ===
# The .dem is parsed locally, and AI analysis also stays on this PC.
AI_GATEWAY_URL=http://127.0.0.1:11435
AI_GATEWAY_TOKEN=
AI_TIMEOUT_MS=600000

# Ollama server and model used by the local gateway.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_GATEWAY_PORT=11435

# Optional fallback only. Leave empty when using Ollama.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

PORT=3000
MAX_DEMO_MB=800
