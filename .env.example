# === Recommended mode: remote AI gateway ===
# The .dem is parsed locally. Only compact match JSON is sent to the gateway.
AI_GATEWAY_URL=https://YOUR-GATEWAY-DOMAIN.example
AI_GATEWAY_TOKEN=replace-with-a-long-random-token
AI_TIMEOUT_MS=90000

# === Optional fallback: direct OpenAI from this PC/server ===
# Leave empty when using AI_GATEWAY_URL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

PORT=3000
MAX_DEMO_MB=800
